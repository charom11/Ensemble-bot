//@version=5
strategy("Institutional 8-Step SMC MTF Strategy (4H -> 30M -> 5M MSS)", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.04)

// ==============================================================================
// 1. INPUTS & CONFIGURATION
// ==============================================================================
rr_ratio            = input.float(2.5, "Risk-to-Reward Ratio (1:X)", minval=1.0, maxval=10.0, step=0.1)
atr_period          = input.int(14, "ATR Length", minval=1)
swing_lookback      = input.int(3, "5m Swing High/Low Lookback", minval=1, maxval=10)
show_poi_boxes      = input.bool(true, "Display 30m POI Zones on Chart")
show_table          = input.bool(true, "Display SMC Status Dashboard Table")

// ==============================================================================
// 2. STEP 1: 4-HOUR MACRO BIAS (DIRECTIONAL FILTER)
// ==============================================================================
tf_4h_close         = request.security(syminfo.tickerid, "240", close)
tf_4h_ema20         = request.security(syminfo.tickerid, "240", ta.ema(close, 20))
tf_4h_ema50         = request.security(syminfo.tickerid, "240", ta.ema(close, 50))
tf_4h_ema200        = request.security(syminfo.tickerid, "240", ta.ema(close, 200))

bool bias_4h_bullish = (tf_4h_close > tf_4h_ema50 and tf_4h_ema20 >= tf_4h_ema50)
bool bias_4h_bearish = (tf_4h_close < tf_4h_ema50 and tf_4h_ema20 <= tf_4h_ema50)
string macro_bias_str = bias_4h_bullish ? "BUYS ONLY (Bullish)" : (bias_4h_bearish ? "SELLS ONLY (Bearish)" : "NEUTRAL")

// Background tint based on 4H bias
bgcolor(bias_4h_bullish ? color.new(color.green, 94) : (bias_4h_bearish ? color.new(color.red, 94) : na), title="4H Macro Bias Background")

// ==============================================================================
// 3. STEP 2 & 3: 30-MINUTE MODE & POI DEMAND/SUPPLY AREAS
// ==============================================================================
tf_30m_high         = request.security(syminfo.tickerid, "30", high)
tf_30m_low          = request.security(syminfo.tickerid, "30", low)
tf_30m_close        = request.security(syminfo.tickerid, "30", close)
tf_30m_highest20    = request.security(syminfo.tickerid, "30", ta.highest(high, 20))
tf_30m_lowest20     = request.security(syminfo.tickerid, "30", ta.lowest(low, 20))
tf_30m_swing_low    = request.security(syminfo.tickerid, "30", ta.lowest(low, 5))
tf_30m_swing_high   = request.security(syminfo.tickerid, "30", ta.highest(high, 5))

// 30m Mode Decision: Pullback vs Continuation
bool mode_30m_pullback = bias_4h_bullish ? (tf_30m_close < tf_30m_highest20 * 0.995) : (tf_30m_close > tf_30m_lowest20 * 1.005)
string mode_30m_str   = mode_30m_pullback ? "PULLBACK MODE" : "CONTINUATION MODE"

// 30m POI Zones: Demand (for Buys) | Supply (for Sells)
float poi_top    = bias_4h_bullish ? (tf_30m_swing_low * 1.006) : (tf_30m_swing_high * 1.006)
float poi_bottom = bias_4h_bullish ? (tf_30m_swing_low * 0.994) : (tf_30m_swing_high * 0.994)

// ==============================================================================
// 4. STEP 4 & 5: 5-MINUTE POI TAP DETECTION
// ==============================================================================
bool tapped_poi_buy  = bias_4h_bullish and (low <= poi_top)
bool tapped_poi_sell = bias_4h_bearish and (high >= poi_bottom)
var bool in_poi_zone = false

if (tapped_poi_buy or tapped_poi_sell)
    in_poi_zone := true

// ==============================================================================
// 5. STEP 6 & 7: 5-MINUTE MSS / CHOCH ENTRY TRIGGER (WITH 4H BIAS)
// ==============================================================================
// Fractal Swing Highs & Lows on 5m
swing_h_5m = ta.highest(high, swing_lookback)
swing_l_5m = ta.lowest(low, swing_lookback)
swing_h_prev = ta.valuewhen(high == swing_h_5m, high, 1)
swing_l_prev = ta.valuewhen(low == swing_l_5m, low, 1)

// 5m MSS / CHoCH Triggers:
// Bullish MSS: 5m Candle breaks above previous 5m Swing High AFTER tapping 30m Demand
bool mss_bullish = bias_4h_bullish and in_poi_zone and ta.crossover(close, swing_h_prev)

// Bearish MSS: 5m Candle breaks below previous 5m Swing Low AFTER tapping 30m Supply
bool mss_bearish = bias_4h_bearish and in_poi_zone and ta.crossunder(close, swing_l_prev)

// Reset POI tap state after trigger
if (mss_bullish or mss_bearish)
    in_poi_zone := false

// ==============================================================================
// 6. STEP 8: RISK MANAGEMENT (STOP LOSS & TAKE PROFIT 1:2.5 RR)
// ==============================================================================
var float long_sl  = 0.0
var float long_tp  = 0.0
var float short_sl = 0.0
var float short_tp = 0.0

if (mss_bullish and strategy.position_size == 0)
    long_sl := math.min(swing_l_5m, low[1]) * 0.9985
    float risk = close - long_sl
    long_tp := close + (risk * rr_ratio)
    strategy.entry("SMC_BUY", strategy.long)
    strategy.exit("TP/SL_BUY", "SMC_BUY", stop=long_sl, limit=long_tp)

if (mss_bearish and strategy.position_size == 0)
    short_sl := math.max(swing_h_5m, high[1]) * 1.0015
    float risk = short_sl - close
    short_tp := close - (risk * rr_ratio)
    strategy.entry("SMC_SELL", strategy.short)
    strategy.exit("TP/SL_SELL", "SMC_SELL", stop=short_sl, limit=short_tp)

// ==============================================================================
// 7. VISUAL SIGNALS & DASHBOARD
// ==============================================================================
plotshape(mss_bullish, title="5m MSS Bullish (CHoCH Long)", style=shape.labelup, location=location.belowbar, color=color.green, text="MSS BUY\n(CHoCH)", textcolor=color.white, size=size.normal)
plotshape(mss_bearish, title="5m MSS Bearish (CHoCH Short)", style=shape.labeldown, location=location.abovebar, color=color.red, text="MSS SELL\n(CHoCH)", textcolor=color.white, size=size.normal)

// POI Zone Visuals
plot(show_poi_boxes and bias_4h_bullish ? poi_top : na, "30m Demand Top", color=color.new(color.green, 50), style=plot.style_linebr)
plot(show_poi_boxes and bias_4h_bullish ? poi_bottom : na, "30m Demand Bottom", color=color.new(color.green, 50), style=plot.style_linebr)
plot(show_poi_boxes and bias_4h_bearish ? poi_top : na, "30m Supply Top", color=color.new(color.red, 50), style=plot.style_linebr)
plot(show_poi_boxes and bias_4h_bearish ? poi_bottom : na, "30m Supply Bottom", color=color.new(color.red, 50), style=plot.style_linebr)

// Trade Entry Lines
plot(strategy.position_size > 0 ? long_sl : (strategy.position_size < 0 ? short_sl : na), "Stop Loss Level", color=color.red, style=plot.style_circles, linewidth=2)
plot(strategy.position_size > 0 ? long_tp : (strategy.position_size < 0 ? short_tp : na), "Take Profit Level", color=color.green, style=plot.style_circles, linewidth=2)

// Status Dashboard Table
if (show_table and barstate.islast)
    var table tb = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
    table.cell(tb, 0, 0, "SMC MTF Strategy", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 0, "Current State", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    
    table.cell(tb, 0, 1, "1. 4H Macro Bias", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 1, macro_bias_str, text_color=bias_4h_bullish ? color.green : color.red, text_size=size.small)
    
    table.cell(tb, 0, 2, "2. 30m Mode", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 2, mode_30m_str, text_color=color.yellow, text_size=size.small)
    
    table.cell(tb, 0, 3, "3. 30m POI Area", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 3, str.tostring(poi_bottom, "#.####") + " - " + str.tostring(poi_top, "#.####"), text_color=color.aqua, text_size=size.small)
    
    table.cell(tb, 0, 4, "4. POI Zone Tapped?", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 4, in_poi_zone ? "YES (Arming 5m MSS)" : "Waiting for Tap...", text_color=in_poi_zone ? color.green : color.gray, text_size=size.small)
    
    table.cell(tb, 0, 5, "Risk-to-Reward", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 5, "1:" + str.tostring(rr_ratio, "#.#") + " RR", text_color=color.white, text_size=size.small)
