//@version=5
strategy("Weather-Ensemble 31-Model Consensus Strategy", shorttitle="Meteo31_Strategy", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.04, slippage=1)

// ==============================================================================
// 1. INPUT PARAMETERS & RISK CONFIGURATION
// ==============================================================================
// Consensus Rules
thresholdInput  = input.int(30, title="Consensus Threshold", minval=20, maxval=31, tooltip="Number of models that must agree to trigger a trade (out of 31).")
logicMode       = input.string("Realistic Indicators", title="Engine Logic Mode", options=["Realistic Indicators", "Python/JS Bot Match"], tooltip="Select whether to use realistic TradingView indicators or match the simplified Python/JS bot mock logic.")
tradeDirection  = input.string("Both", title="Trading Direction", options=["Both", "Long Only", "Short Only"])

// Risk Management & Exit Types
exitType        = input.string("ATR Multiplier", title="Exit Calculation Type", options=["Percentage", "ATR Multiplier"], group="Risk Management", tooltip="Select whether profit and stop loss exits are fixed percentages or multiples of ATR.")
useTP           = input.bool(true, title="Use Take Profit", group="Risk Management")
tpPct           = input.float(1.5, title="Take Profit (%)", step=0.1, group="Risk Management")
atrTPMult       = input.float(2.4, title="ATR Take Profit Multiplier", step=0.1, group="Risk Management")
useSL           = input.bool(true, title="Use Stop Loss", group="Risk Management")
slPct           = input.float(1.0, title="Stop Loss (%)", step=0.1, group="Risk Management")
atrSLMult       = input.float(0.8, title="ATR Stop Loss Multiplier", step=0.1, group="Risk Management")

// Break-Even + Fees trailing stop
useBreakEven      = input.bool(true, title="Use Break-Even + Fees SL", group="Risk Management", tooltip="Move SL to break-even (plus fees or ATR buffer) when price moves in favor by activation distance.")
beType            = input.string("ATR Multiplier", title="BE Lock Profit Type", options=["Percentage", "ATR Multiplier"], group="Risk Management")
beActivationMult  = input.float(1.0, title="Break-Even ATR Activation", step=0.1, group="Risk Management")
beLockProfitPct   = input.float(0.15, title="Break-Even Lock Profit (%)", step=0.01, group="Risk Management")
beLockProfitMult  = input.float(0.3, title="Break-Even Lock ATR Multiplier", step=0.05, group="Risk Management", tooltip="ATR multiplier to lock in when break-even is triggered (e.g. 0.3 * ATR).")

useTrailing     = input.bool(false, title="Use Trailing Stop", group="Risk Management")
trailActivation = input.float(1.0, title="Trailing Activation (%)", step=0.1, group="Risk Management")
trailDeviation  = input.float(0.5, title="Trailing Deviation (%)", step=0.1, group="Risk Management")

exitOnConsensusLoss = input.bool(false, title="Exit on Consensus Loss", tooltip="Exit active trades if the agreeing consensus falls below the threshold.", group="Risk Management")
lossThreshold       = input.int(16, title="Exit Consensus Threshold", minval=0, maxval=31, tooltip="If consensus falls below this number, close position.", group="Risk Management")

// Entry Filters
useMacroFilter  = input.bool(true, title="Use Macro EMA Trend Alignment", group="Filters", tooltip="Only enter long trades when price is above EMA 300 & EMA 1200. Only enter short trades when price is below them.")
useVolumeFilter = input.bool(true, title="Use Volume Surge Filter", group="Filters", tooltip="Only enter when the current bar's volume exceeds the average volume by a surge factor.")
volumeFactor    = input.float(1.15, title="Volume Surge Factor", step=0.05, group="Filters")
useAtrFilter    = input.bool(true, title="Use ATR Volatility Filter", group="Filters", tooltip="Only enter when short-term ATR(14) is expanding relative to long-term ATR(50).")
atrExpansionFactor = input.float(1.05, title="ATR Expansion Factor", step=0.01, group="Filters")

// Visual Dashboard
showDashboard   = input.bool(true, title="Show Dashboard Table", group="Visuals")
dashPosition    = input.string("top_right", title="Dashboard Position", options=["top_right", "bottom_right", "top_left", "bottom_left"], group="Visuals")
showBgColor     = input.bool(true, title="Color Chart Background on Consensus", group="Visuals")

// Backtesting Window
startGroup      = "Backtest Start Date"
useStartDate    = input.bool(true, "Filter Start Date", group=startGroup)
startYear       = input.int(2025, "Year", group=startGroup)
startMonth      = input.int(1, "Month", minval=1, maxval=12, group=startGroup)
startDay        = input.int(1, "Day", minval=1, maxval=31, group=startGroup)

endGroup        = "Backtest End Date"
useEndDate      = input.bool(false, "Filter End Date", group=endGroup)
endYear         = input.int(2026, "Year", group=endGroup)
endMonth        = input.int(12, "Month", minval=1, maxval=12, group=endGroup)
endDay          = input.int(31, "Day", minval=1, maxval=31, group=endGroup)

// Date filter logic
inBacktestRange = true
if useStartDate
    inBacktestRange := inBacktestRange and (time >= timestamp(startYear, startMonth, startDay, 0, 0))
if useEndDate
    inBacktestRange := inBacktestRange and (time <= timestamp(endYear, endMonth, endDay, 23, 59))

// ==============================================================================
// 2. HELPER FUNCTIONS & MATH ENGINE
// ==============================================================================
// Global function to set cell values in the visual dashboard
f_set_cell(tbl, col, row, txt, val) =>
    bg_col = val == 1 ? color.rgb(34, 197, 94) : (val == -1 ? color.rgb(239, 68, 68) : color.rgb(71, 85, 105))
    table.cell(tbl, col, row, txt, text_color=color.white, bgcolor=bg_col, text_size=size.small)

// 1D Kalman Filter implementation for Model M29
f_kalman(src) =>
    var float x = na
    var float p = 1.0
    const float q = 0.01 // Process variance
    const float r = 0.1  // Measurement variance
    if na(x)
        x := src
    else
        p_val = p + q
        k = p_val / (p_val + r)
        x := x + k * (src - x)
        p := (1 - k) * p_val
    x

// Seeded perturbation generator for Bot ML models (M26-M31)
calc_bot_ml(idx, score_base) =>
    pert = math.sin(idx * 1.5 + (bar_index + 1) * 0.3) * 0.001
    score = score_base + pert
    score > 0.0002 ? 1 : (score < -0.0002 ? -1 : 0)

// ==============================================================================
// 3. 31 AUTONOMOUS MODEL CALCULATIONS
// ==============================================================================
// Base standard indicator calculations
ema8   = ta.ema(close, 8)
ema21  = ta.ema(close, 21)
ema13  = ta.ema(close, 13)
ema55  = ta.ema(close, 55)
ema10  = ta.ema(close, 10)
ema20  = ta.ema(close, 20)
sma20  = ta.sma(close, 20)
std20  = ta.stdev(close, 20)
atr14  = ta.atr(14)
atr20  = ta.atr(20)

// [M01 & M02] EMA Cross Fast & Slow
m01 = ema8 > ema21 ? 1 : -1
m02 = ema13 > ema55 ? 1 : -1

// [M03] MACD Acceleration
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
m03 = logicMode == "Realistic Indicators" ? (macdLine > signalLine ? 1 : -1) : (macdLine > 0 ? 1 : -1)

// [M04 & M05] Supertrend Alpha & Fast
[st_3_10, dir_3_10] = ta.supertrend(3.0, 10)
[st_2_7, dir_2_7]   = ta.supertrend(2.0, 7)
m04_bot  = close > close[10] + atr14 ? 1 : -1
m04_real = dir_3_10 < 0 ? 1 : -1
m04 = logicMode == "Realistic Indicators" ? m04_real : m04_bot

m05_bot  = close > close[7] + 0.5 * atr14 ? 1 : -1
m05_real = dir_2_7 < 0 ? 1 : -1
m05 = logicMode == "Realistic Indicators" ? m05_real : m05_bot

// [M06 & M07] Donchian Breakout 20 & 50
max20 = ta.highest(high, 20)
min20 = ta.lowest(low, 20)
m06_bot  = close >= max20 * 0.998 ? 1 : (close <= min20 * 1.002 ? -1 : 0)
m06_real = close > max20[1] ? 1 : (close < min20[1] ? -1 : 0)
m06 = logicMode == "Realistic Indicators" ? m06_real : m06_bot

max50 = ta.highest(high, 50)
min50 = ta.lowest(low, 50)
m07_bot  = close >= max50 * 0.998 ? 1 : (close <= min50 * 1.002 ? -1 : 0)
m07_real = close > max50[1] ? 1 : (close < min50[1] ? -1 : 0)
m07 = logicMode == "Realistic Indicators" ? m07_real : m07_bot

// [M08] Parabolic SAR Direction
psarVal  = ta.sar(0.02, 0.02, 0.2)
m08_bot  = close > ema10 ? 1 : -1
m08_real = close > psarVal ? 1 : -1
m08 = logicMode == "Realistic Indicators" ? m08_real : m08_bot

// [M09] Ichimoku Cloud Span
tenkan   = (ta.highest(high, 9) + ta.lowest(low, 9)) / 2
kijun    = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2
senkouA  = (tenkan[26] + kijun[26]) / 2
senkouB  = (ta.highest(high, 52)[26] + ta.lowest(low, 52)[26]) / 2
m09_bot  = tenkan > kijun ? 1 : -1
m09_real = close > senkouA and close > senkouB ? 1 : (close < senkouA and close < senkouB ? -1 : 0)
m09 = logicMode == "Realistic Indicators" ? m09_real : m09_bot

// [M10] RSI 14
rsi14 = ta.rsi(close, 14)
m10_bot  = rsi14 > 54 ? 1 : (rsi14 < 46 ? -1 : 0)
m10_real = rsi14 > 50 ? 1 : -1
m10 = logicMode == "Realistic Indicators" ? m10_real : m10_bot

// [M11-M16] Momentum Oscillators
mom5  = (close - close[5]) / close[5]
mom6  = (close - close[6]) / close[6]
mom7  = (close - close[7]) / close[7]
mom8  = (close - close[8]) / close[8]
mom9  = (close - close[9]) / close[9]
mom10 = (close - close[10]) / close[10]

m11_bot = mom5 > 0.0008 ? 1 : (mom5 < -0.0008 ? -1 : 0)
m12_bot = mom6 > 0.0008 ? 1 : (mom6 < -0.0008 ? -1 : 0)
m13_bot = mom7 > 0.0008 ? 1 : (mom7 < -0.0008 ? -1 : 0)
m14_bot = mom8 > 0.0008 ? 1 : (mom8 < -0.0008 ? -1 : 0)
m15_bot = mom9 > 0.0008 ? 1 : (mom9 < -0.0008 ? -1 : 0)
m16_bot = mom10 > 0.0008 ? 1 : (mom10 < -0.0008 ? -1 : 0)

rsiVal   = ta.rsi(close, 14)
stochK   = ta.sma(ta.stoch(rsiVal, rsiVal, rsiVal, 14), 3)
stochD   = ta.sma(stochK, 3)
m11_real = stochK > stochD ? 1 : -1

wpr      = ta.wpr(14)
m12_real = wpr > -50 ? 1 : -1

cci      = ta.cci(close, 20)
m13_real = cci > 0 ? 1 : -1

roc      = ta.roc(close, 10)
m14_real = roc > 0 ? 1 : -1

co       = close - open
hl       = high - low
num      = (co + 2 * co[1] + 2 * co[2] + co[3]) / 6
den      = (hl + 2 * hl[1] + 2 * hl[2] + hl[3]) / 6
rvi_val  = ta.sma(num, 14) / math.max(ta.sma(den, 14), 0.000001)
rvisig   = (rvi_val + 2 * rvi_val[1] + 2 * rvi_val[2] + rvi_val[3]) / 6
m15_real = rvi_val > rvisig ? 1 : -1

ao       = ta.sma(hl2, 5) - ta.sma(hl2, 34)
m16_real = ao > 0 ? 1 : -1

m11 = logicMode == "Realistic Indicators" ? m11_real : m11_bot
m12 = logicMode == "Realistic Indicators" ? m12_real : m12_bot
m13 = logicMode == "Realistic Indicators" ? m13_real : m13_bot
m14 = logicMode == "Realistic Indicators" ? m14_real : m14_bot
m15 = logicMode == "Realistic Indicators" ? m15_real : m15_bot
m16 = logicMode == "Realistic Indicators" ? m16_real : m16_bot

// [M17-M21] Volatility Models
b_pct_val = std20 > 0 ? (close - (sma20 - 2 * std20)) / (4 * std20) : 0.5
m17_bot = b_pct_val > 0.50 ? 1 : (b_pct_val < 0.50 ? -1 : 0)
m18_bot = b_pct_val > 0.52 ? 1 : (b_pct_val < 0.48 ? -1 : 0)
m19_bot = b_pct_val > 0.54 ? 1 : (b_pct_val < 0.46 ? -1 : 0)
m20_bot = b_pct_val > 0.56 ? 1 : (b_pct_val < 0.44 ? -1 : 0)
m21_bot = b_pct_val > 0.58 ? 1 : (b_pct_val < 0.42 ? -1 : 0)

m17_real = b_pct_val > 0.8 ? 1 : (b_pct_val < 0.2 ? -1 : 0)
squeeze  = (4 * std20) < (1.5 * atr20)
m18_real = not squeeze ? (close > sma20 ? 1 : -1) : 0
k_upper  = ema20 + 2.0 * atr20
k_lower  = ema20 - 2.0 * atr20
m19_real = close > k_upper ? 1 : (close < k_lower ? -1 : 0)
atr_sma  = ta.sma(atr14, 20)
m20_real = atr14 > atr_sma ? (close > close[1] ? 1 : -1) : 0
hl_ema   = ta.ema(high - low, 10)
chaikin_vol = hl_ema[10] > 0 ? (hl_ema - hl_ema[10]) / hl_ema[10] * 100 : 0.0
m21_real = chaikin_vol > 0 ? (close > close[1] ? 1 : -1) : 0

m17 = logicMode == "Realistic Indicators" ? m17_real : m17_bot
m18 = logicMode == "Realistic Indicators" ? m18_real : m18_bot
m19 = logicMode == "Realistic Indicators" ? m19_real : m19_bot
m20 = logicMode == "Realistic Indicators" ? m20_real : m20_bot
m21 = logicMode == "Realistic Indicators" ? m21_real : m21_bot

// [M22-M25] VWAP Models
vwap_num20   = ta.sma(close * volume, 20) * 20
vwap_den20   = ta.sma(volume, 20) * 20
vwap_bot20   = vwap_den20 > 0 ? vwap_num20 / vwap_den20 : close
vwap_sig_bot = close >= vwap_bot20 ? 1 : -1

m22_bot = vwap_sig_bot
m23_bot = vwap_sig_bot
m24_bot = vwap_sig_bot
m25_bot = vwap_sig_bot

vwap_intraday = ta.vwap
m22_real = close > vwap_intraday ? 1 : -1
m23_real = vwap_intraday > vwap_intraday[1] ? 1 : -1
vfi_ema  = ta.ema(volume * (close - hl2) / math.max(hl2, 0.000001), 14)
m24_real = vfi_ema > 0 ? 1 : -1
range_hl = math.max(high - low, 0.000001)
buy_vol  = volume * (close - low) / range_hl
sell_vol = volume * (high - close) / range_hl
of_delta = buy_vol - sell_vol
m25_real = of_delta > 0 ? 1 : -1

m22 = logicMode == "Realistic Indicators" ? m22_real : m22_bot
m23 = logicMode == "Realistic Indicators" ? m23_real : m23_bot
m24 = logicMode == "Realistic Indicators" ? m24_real : m24_bot
m25 = logicMode == "Realistic Indicators" ? m25_real : m25_bot

// [M26-M31] ML & Statistical Perturbations
score_base = (close - sma20) / math.max(close, 0.000001)
m26_bot = calc_bot_ml(26, score_base)
m27_bot = calc_bot_ml(27, score_base)
m28_bot = calc_bot_ml(28, score_base)
m29_bot = calc_bot_ml(29, score_base)
m30_bot = calc_bot_ml(30, score_base)
m31_bot = calc_bot_ml(31, score_base)

slope    = ta.linreg(close, 20, 0) - ta.linreg(close, 20, 1)
m26_real = slope > 0 ? 1 : -1

hma16    = ta.hma(close, 16)
m27_real = close > hma16 ? 1 : -1

zscore   = std20 > 0 ? (close - sma20) / std20 : 0.0
m28_real = zscore > 1.0 ? 1 : (zscore < -1.0 ? -1 : 0)

kf_val   = f_kalman(close)
m29_real = close > kf_val ? 1 : -1

drift      = close[1] > 0 ? (close - close[1]) / close[1] : 0.0
mean_drift = ta.sma(drift, 20)
m30_real   = mean_drift > 0 ? 1 : -1

rsi8     = ta.rsi(close, 8)
m31_real = rsi8 > 50 ? 1 : -1

m26 = logicMode == "Realistic Indicators" ? m26_real : m26_bot
m27 = logicMode == "Realistic Indicators" ? m27_real : m27_bot
m28 = logicMode == "Realistic Indicators" ? m28_real : m28_bot
m29 = logicMode == "Realistic Indicators" ? m29_real : m29_bot
m30 = logicMode == "Realistic Indicators" ? m30_real : m30_bot
m31 = logicMode == "Realistic Indicators" ? m31_real : m31_bot

// ==============================================================================
// 4. CONSENSUS RULES & TRADING LOGIC
// ==============================================================================
// Count votes across the 31 models
bull_votes = (m01 == 1 ? 1 : 0) + (m02 == 1 ? 1 : 0) + (m03 == 1 ? 1 : 0) + (m04 == 1 ? 1 : 0) + (m05 == 1 ? 1 : 0) +
             (m06 == 1 ? 1 : 0) + (m07 == 1 ? 1 : 0) + (m08 == 1 ? 1 : 0) + (m09 == 1 ? 1 : 0) + (m10 == 1 ? 1 : 0) +
             (m11 == 1 ? 1 : 0) + (m12 == 1 ? 1 : 0) + (m13 == 1 ? 1 : 0) + (m14 == 1 ? 1 : 0) + (m15 == 1 ? 1 : 0) +
             (m16 == 1 ? 1 : 0) + (m17 == 1 ? 1 : 0) + (m18 == 1 ? 1 : 0) + (m19 == 1 ? 1 : 0) + (m20 == 1 ? 1 : 0) +
             (m21 == 1 ? 1 : 0) + (m22 == 1 ? 1 : 0) + (m23 == 1 ? 1 : 0) + (m24 == 1 ? 1 : 0) + (m25 == 1 ? 1 : 0) +
             (m26 == 1 ? 1 : 0) + (m27 == 1 ? 1 : 0) + (m28 == 1 ? 1 : 0) + (m29 == 1 ? 1 : 0) + (m30 == 1 ? 1 : 0) +
             (m31 == 1 ? 1 : 0)

bear_votes = (m01 == -1 ? 1 : 0) + (m02 == -1 ? 1 : 0) + (m03 == -1 ? 1 : 0) + (m04 == -1 ? 1 : 0) + (m05 == -1 ? 1 : 0) +
             (m06 == -1 ? 1 : 0) + (m07 == -1 ? 1 : 0) + (m08 == -1 ? 1 : 0) + (m09 == -1 ? 1 : 0) + (m10 == -1 ? 1 : 0) +
             (m11 == -1 ? 1 : 0) + (m12 == -1 ? 1 : 0) + (m13 == -1 ? 1 : 0) + (m14 == -1 ? 1 : 0) + (m15 == -1 ? 1 : 0) +
             (m16 == -1 ? 1 : 0) + (m17 == -1 ? 1 : 0) + (m18 == -1 ? 1 : 0) + (m19 == -1 ? 1 : 0) + (m20 == -1 ? 1 : 0) +
             (m21 == -1 ? 1 : 0) + (m22 == -1 ? 1 : 0) + (m23 == -1 ? 1 : 0) + (m24 == -1 ? 1 : 0) + (m25 == -1 ? 1 : 0) +
             (m26 == -1 ? 1 : 0) + (m27 == -1 ? 1 : 0) + (m28 == -1 ? 1 : 0) + (m29 == -1 ? 1 : 0) + (m30 == -1 ? 1 : 0) +
             (m31 == -1 ? 1 : 0)

max_consensus = math.max(bull_votes, bear_votes)
agreement_pct = (max_consensus / 31.0) * 100.0

// Entry Filters & Alignment
ema300   = ta.ema(close, 300)
ema1200  = ta.ema(close, 1200)
volSma20 = ta.sma(volume, 20)
atr50    = ta.atr(50)

macroLong  = not useMacroFilter or (close >= ema300 and close >= ema1200)
macroShort = not useMacroFilter or (close <= ema300 and close <= ema1200)
volSurge   = not useVolumeFilter or (volume >= volSma20 * volumeFactor)
atrConfluence = not useAtrFilter or (atr14 >= atr50 * atrExpansionFactor)

longCondition  = (bull_votes >= thresholdInput) and (tradeDirection == "Both" or tradeDirection == "Long Only") and macroLong and volSurge and atrConfluence
shortCondition = (bear_votes >= thresholdInput) and (tradeDirection == "Both" or tradeDirection == "Short Only") and macroShort and volSurge and atrConfluence

// ==============================================================================
// 5. RISK MANAGEMENT & EXECUTION
// ==============================================================================
// Custom Trailing Stop Calculations (Percentage-Based, scale-independent)
var float long_trail_price  = na
var float short_trail_price = na

if strategy.position_size > 0
    if useTrailing
        trail_act_lvl = strategy.position_avg_price * (1.0 + trailActivation / 100.0)
        trail_dev_val = close * (trailDeviation / 100.0)
        if high >= trail_act_lvl
            new_stop = high - trail_dev_val
            long_trail_price := na(long_trail_price) ? new_stop : math.max(long_trail_price, new_stop)
    else
        long_trail_price := na
else
    long_trail_price := na

if strategy.position_size < 0
    if useTrailing
        trail_act_lvl = strategy.position_avg_price * (1.0 - trailActivation / 100.0)
        trail_dev_val = close * (trailDeviation / 100.0)
        if low <= trail_act_lvl
            new_stop = low + trail_dev_val
            short_trail_price := na(short_trail_price) ? new_stop : math.min(short_trail_price, new_stop)
    else
        short_trail_price := na
else
    short_trail_price := na

// Exits based on loss of consensus
exit_long_loss  = exitOnConsensusLoss and (bull_votes < lossThreshold)
exit_short_loss = exitOnConsensusLoss and (bear_votes < lossThreshold)

// Track ATR at entry bar (grabbed from signal bar for backtest alignment)
var float entry_atr = na
if strategy.position_size != strategy.position_size[1] and strategy.position_size != 0
    entry_atr := atr14[1]

// Break-Even + Fees trailing trigger
var float highest_favorable = na
var float lowest_favorable = na
var bool break_even_triggered = false

if strategy.position_size > 0
    highest_favorable := na(highest_favorable) ? high : math.max(highest_favorable, high)
    activation_lvl = strategy.position_avg_price + beActivationMult * entry_atr
    if highest_favorable >= activation_lvl
        break_even_triggered := true
else if strategy.position_size < 0
    lowest_favorable := na(lowest_favorable) ? low : math.min(lowest_favorable, low)
    activation_lvl = strategy.position_avg_price - beActivationMult * entry_atr
    if lowest_favorable <= activation_lvl
        break_even_triggered := true
else
    highest_favorable := na
    lowest_favorable := na
    break_even_triggered := false

// Execute entries
if inBacktestRange
    if longCondition
        strategy.entry("Long", strategy.long)
    if shortCondition
        strategy.entry("Short", strategy.short)

// Calculate dynamic exit prices
var float active_tp = na
var float active_sl = na

if strategy.position_size > 0
    active_tp := exitType == "ATR Multiplier" ? (strategy.position_avg_price + atrTPMult * entry_atr) : (strategy.position_avg_price * (1.0 + tpPct / 100.0))
    init_sl = exitType == "ATR Multiplier" ? (strategy.position_avg_price - atrSLMult * entry_atr) : (strategy.position_avg_price * (1.0 - slPct / 100.0))
    be_sl = beType == "ATR Multiplier" ? (strategy.position_avg_price + beLockProfitMult * entry_atr) : (strategy.position_avg_price * (1.0 + beLockProfitPct / 100.0))
    active_sl := (useBreakEven and break_even_triggered) ? be_sl : init_sl
else if strategy.position_size < 0
    active_tp := exitType == "ATR Multiplier" ? (strategy.position_avg_price - atrTPMult * entry_atr) : (strategy.position_avg_price * (1.0 - tpPct / 100.0))
    init_sl = exitType == "ATR Multiplier" ? (strategy.position_avg_price + atrSLMult * entry_atr) : (strategy.position_avg_price * (1.0 + slPct / 100.0))
    be_sl = beType == "ATR Multiplier" ? (strategy.position_avg_price - beLockProfitMult * entry_atr) : (strategy.position_avg_price * (1.0 - beLockProfitPct / 100.0))
    active_sl := (useBreakEven and break_even_triggered) ? be_sl : init_sl
else
    active_tp := na
    active_sl := na

// Execute exits
if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", limit=useTP ? active_tp : na, stop=useSL ? active_sl : na)
    if useTrailing and not na(long_trail_price) and close <= long_trail_price
        strategy.close("Long", comment="Trailing Stop")
    if exit_long_loss
        strategy.close("Long", comment="Consensus Loss")

if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", limit=useTP ? active_tp : na, stop=useSL ? active_sl : na)
    if useTrailing and not na(short_trail_price) and close >= short_trail_price
        strategy.close("Short", comment="Trailing Stop")
    if exit_short_loss
        strategy.close("Short", comment="Consensus Loss")

// ==============================================================================
// 6. CHART VISUALIZATION & DYNAMIC PLOTS
// ==============================================================================
// Background color-coding based on consensus signals
bg_col = (bull_votes >= thresholdInput) ? color.new(color.rgb(34, 197, 94), 92) : ((bear_votes >= thresholdInput) ? color.new(color.rgb(239, 68, 68), 92) : na)
bgcolor(showBgColor ? bg_col : na)

// Plot trailing stop levels for active monitoring
plot(strategy.position_size > 0 and useTrailing ? long_trail_price : na, title="Long Trailing Stop", color=color.orange, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size < 0 and useTrailing ? short_trail_price : na, title="Short Trailing Stop", color=color.orange, style=plot.style_linebr, linewidth=2)

// ==============================================================================
// 7. GUI FLOATING DASHBOARD TABLE
// ==============================================================================
table_position = dashPosition == "top_right" ? position.top_right :
                 dashPosition == "bottom_right" ? position.bottom_right :
                 dashPosition == "top_left" ? position.top_left :
                 position.bottom_left

var table dashboard = showDashboard ? table.new(table_position, 4, 13, color.rgb(15, 23, 42), color.rgb(51, 65, 85), 1, color.rgb(51, 65, 85), 1) : na

if showDashboard and barstate.islast
    // Header title row
    table.cell(dashboard, 0, 0, "WEATHER-ENSEMBLE BTC CONSENSUS", text_color=color.white, bgcolor=color.rgb(15, 23, 42), text_size=size.normal)
    table.cell(dashboard, 1, 0, "", bgcolor=color.rgb(15, 23, 42))
    table.cell(dashboard, 2, 0, "", bgcolor=color.rgb(15, 23, 42))
    table.cell(dashboard, 3, 0, "", bgcolor=color.rgb(15, 23, 42))
    table.merge_cells(dashboard, 0, 0, 3, 0)
    
    // Consensus summary status row
    status_text = "Consensus: " + str.tostring(max_consensus) + "/31 (" + str.tostring(agreement_pct, "#.#") + "%) - " + (bull_votes >= bear_votes ? "BULLISH 🟢" : "BEARISH 🔴")
    status_bg = bull_votes >= thresholdInput ? color.rgb(22, 163, 74) : (bear_votes >= thresholdInput ? color.rgb(220, 38, 38) : color.rgb(30, 41, 59))
    table.cell(dashboard, 0, 1, status_text, text_color=color.white, bgcolor=status_bg, text_size=size.small)
    table.cell(dashboard, 1, 1, "", bgcolor=status_bg)
    table.cell(dashboard, 2, 1, "", bgcolor=status_bg)
    table.cell(dashboard, 3, 1, "", bgcolor=status_bg)
    table.merge_cells(dashboard, 0, 1, 3, 1)

    // Category columns
    table.cell(dashboard, 0, 2, "Trend Paradigm (9)", text_color=color.rgb(226, 232, 240), bgcolor=color.rgb(15, 23, 42), text_size=size.small)
    table.cell(dashboard, 1, 2, "Momentum Paradigm (7)", text_color=color.rgb(226, 232, 240), bgcolor=color.rgb(15, 23, 42), text_size=size.small)
    table.cell(dashboard, 2, 2, "Volatility Paradigm (5)", text_color=color.rgb(226, 232, 240), bgcolor=color.rgb(15, 23, 42), text_size=size.small)
    table.cell(dashboard, 3, 2, "Micro & ML Paradigm (10)", text_color=color.rgb(226, 232, 240), bgcolor=color.rgb(15, 23, 42), text_size=size.small)

    // Column 0: Trend Paradigm
    f_set_cell(dashboard, 0, 3, "M01 EMA Fast", m01)
    f_set_cell(dashboard, 0, 4, "M02 EMA Slow", m02)
    f_set_cell(dashboard, 0, 5, "M03 MACD Accel", m03)
    f_set_cell(dashboard, 0, 6, "M04 ST Alpha", m04)
    f_set_cell(dashboard, 0, 7, "M05 ST Fast", m05)
    f_set_cell(dashboard, 0, 8, "M06 Donchian 20", m06)
    f_set_cell(dashboard, 0, 9, "M07 Donchian 50", m07)
    f_set_cell(dashboard, 0, 10, "M08 PSAR Dir", m08)
    f_set_cell(dashboard, 0, 11, "M09 Ichimoku", m09)
    table.cell(dashboard, 0, 12, "", bgcolor=color.rgb(15, 23, 42))

    // Column 1: Momentum Paradigm
    f_set_cell(dashboard, 1, 3, "M10 RSI 14", m10)
    f_set_cell(dashboard, 1, 4, "M11 Stoch RSI", m11)
    f_set_cell(dashboard, 1, 5, "M12 Will %R", m12)
    f_set_cell(dashboard, 1, 6, "M13 CCI 20", m13)
    f_set_cell(dashboard, 1, 7, "M14 ROC 10", m14)
    f_set_cell(dashboard, 1, 8, "M15 RVI 14", m15)
    f_set_cell(dashboard, 1, 9, "M16 Awes Osc", m16)
    table.cell(dashboard, 1, 10, "", bgcolor=color.rgb(15, 23, 42))
    table.cell(dashboard, 1, 11, "", bgcolor=color.rgb(15, 23, 42))
    table.cell(dashboard, 1, 12, "", bgcolor=color.rgb(15, 23, 42))

    // Column 2: Volatility Paradigm
    f_set_cell(dashboard, 2, 3, "M17 BB %B", m17)
    f_set_cell(dashboard, 2, 4, "M18 BB Squeeze", m18)
    f_set_cell(dashboard, 2, 5, "M19 Keltner", m19)
    f_set_cell(dashboard, 2, 6, "M20 ATR Exp", m20)
    f_set_cell(dashboard, 2, 7, "M21 Chaikin Vol", m21)
    table.cell(dashboard, 2, 8, "", bgcolor=color.rgb(15, 23, 42))
    table.cell(dashboard, 2, 9, "", bgcolor=color.rgb(15, 23, 42))
    table.cell(dashboard, 2, 10, "", bgcolor=color.rgb(15, 23, 42))
    table.cell(dashboard, 2, 11, "", bgcolor=color.rgb(15, 23, 42))
    table.cell(dashboard, 2, 12, "", bgcolor=color.rgb(15, 23, 42))

    // Column 3: Micro & ML Paradigm
    f_set_cell(dashboard, 3, 3, "M22 VWAP Dist", m22)
    f_set_cell(dashboard, 3, 4, "M23 Anch VWAP", m23)
    f_set_cell(dashboard, 3, 5, "M24 VFI Press", m24)
    f_set_cell(dashboard, 3, 6, "M25 Order Flow", m25)
    f_set_cell(dashboard, 3, 7, "M26 XGBoost", m26)
    f_set_cell(dashboard, 3, 8, "M27 LSTM Neural", m27)
    f_set_cell(dashboard, 3, 9, "M28 Markov Ch", m28)
    f_set_cell(dashboard, 3, 10, "M29 Kalman", m29)
    f_set_cell(dashboard, 3, 11, "M30 Monte Carlo", m30)
    f_set_cell(dashboard, 3, 12, "M31 Weather Core", m31)
