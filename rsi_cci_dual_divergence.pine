//@version=5
strategy("⚡ RSI + CCI Dual Divergence Confluence Strategy", overlay=true, initial_capital=14, default_qty_type=strategy.percent_of_equity, default_qty_value=150)

// ==============================================================================
// ⚡ RSI + CCI DUAL DIVERGENCE QUANT ENGINE
// ==============================================================================
// Concept: 
// 1. CCI (20) acts as the FAST / LEADING cyclical indicator (Statistical Deviation)
// 2. RSI (14) acts as the SMOOTH / CONFIRMING momentum filter (Gain/Loss Ratio)
// 3. Confluence Trigger: When BOTH RSI & CCI diverge at Support/Resistance Floor/Ceiling
// ==============================================================================

// 1. Inputs
rsiLen = input.int(14, "RSI Length")
cciLen = input.int(20, "CCI Length")
leftBars = input.int(10, "Pivot Left Lookback")
rightBars = input.int(4, "Pivot Right Lookback")
macroEmaLen = input.int(200, "Macro Trend EMA Filter")

// 2. Indicators Calculation
rsiVal = ta.rsi(close, rsiLen)
cciVal = ta.cci(close, cciLen)
macroEma = ta.ema(close, macroEmaLen)

plot(macroEma, "200 Macro Trend EMA", color=color.new(color.yellow, 20), linewidth=2)

// 3. Horizontal Support & Resistance Pivots (Floors & Ceilings)
pH = ta.pivothigh(high, leftBars, rightBars)
pL = ta.pivotlow(low, leftBars, rightBars)

var float resistance = na
var float support = na

if not na(pH)
    resistance := pH
if not na(pL)
    support := pL

plot(resistance, "Ceiling (Resistance 🧱)", color=color.new(color.red, 10), linewidth=2, style=plot.style_linebr)
plot(support, "Floor (Support 🛡️)", color=color.new(color.green, 10), linewidth=2, style=plot.style_linebr)

// 4. Divergence Detection Mechanics
// Bullish Divergence: Price Lower Low, RSI Higher Low, CCI Higher Low from oversold
pLow_prev = ta.valuewhen(not na(pL), low[rightBars], 1)
rsi_prev = ta.valuewhen(not na(pL), rsiVal[rightBars], 1)
cci_prev = ta.valuewhen(not na(pL), cciVal[rightBars], 1)

bullRsiDiv = (not na(pL)) and (low[rightBars] < pLow_prev) and (rsiVal[rightBars] > rsi_prev) and (rsiVal[rightBars] < 45)
bullCciDiv = (not na(pL)) and (low[rightBars] < pLow_prev) and (cciVal[rightBars] > cci_prev) and (cciVal[rightBars] < -80)
dualBullDiv = bullRsiDiv and bullCciDiv

// Bearish Divergence: Price Higher High, RSI Lower High, CCI Lower High from overbought
pHigh_prev = ta.valuewhen(not na(pH), high[rightBars], 1)
rsi_high_prev = ta.valuewhen(not na(pH), rsiVal[rightBars], 1)
cci_high_prev = ta.valuewhen(not na(pH), cciVal[rightBars], 1)

bearRsiDiv = (not na(pH)) and (high[rightBars] > pHigh_prev) and (rsiVal[rightBars] < rsi_high_prev) and (rsiVal[rightBars] > 55)
bearCciDiv = (not na(pH)) and (high[rightBars] > pHigh_prev) and (cciVal[rightBars] < cci_high_prev) and (cciVal[rightBars] > 80)
dualBearDiv = bearRsiDiv and bearCciDiv

// 5. Visual Divergence Signals
plotshape(dualBullDiv, "Dual Bullish Divergence 🚀", shape.triangleup, location.belowbar, color.green, size=size.normal, text="DUAL BULL DIV 🟢")
plotshape(dualBearDiv, "Dual Bearish Divergence 💥", shape.triangledown, location.abovebar, color.red, size=size.normal, text="DUAL BEAR DIV 🔴")

// 7. Multi-Timeframe (MTF) Macro Divergence Table HUD (5M, 15M, 1H, 4H)
htf1_close = request.security(syminfo.tickerid, "15", close)
htf1_rsi = request.security(syminfo.tickerid, "15", ta.rsi(close, 14))
htf1_cci = request.security(syminfo.tickerid, "15", ta.cci(close, 20))

htf2_close = request.security(syminfo.tickerid, "60", close)
htf2_rsi = request.security(syminfo.tickerid, "60", ta.rsi(close, 14))
htf2_cci = request.security(syminfo.tickerid, "60", ta.cci(close, 20))

htf3_close = request.security(syminfo.tickerid, "240", close)
htf3_rsi = request.security(syminfo.tickerid, "240", ta.rsi(close, 14))
htf3_cci = request.security(syminfo.tickerid, "240", ta.cci(close, 20))

var table mtfTable = table.new(position.top_right, 5, 4, bgcolor=color.new(#0c0e14, 15), border_width=1, border_color=color.gray)
if barstate.islast
    table.cell(mtfTable, 0, 0, "TIMEFRAME", bgcolor=#161b26, text_color=color.aqua, text_size=size.small)
    table.cell(mtfTable, 1, 0, "RSI (14)", bgcolor=#161b26, text_color=color.aqua, text_size=size.small)
    table.cell(mtfTable, 2, 0, "CCI (20)", bgcolor=#161b26, text_color=color.aqua, text_size=size.small)
    table.cell(mtfTable, 3, 0, "DIVERGENCE", bgcolor=#161b26, text_color=color.aqua, text_size=size.small)
    table.cell(mtfTable, 4, 0, "MACRO BIAS", bgcolor=#161b26, text_color=color.aqua, text_size=size.small)

    table.cell(mtfTable, 0, 1, "5M (Trigger)", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 1, str.tostring(math.round(rsiVal, 1)), text_color=rsiVal > 50 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 2, 1, str.tostring(math.round(cciVal, 1)), text_color=cciVal > 0 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 3, 1, dualBullDiv ? "DUAL BULL 🟢" : (dualBearDiv ? "DUAL BEAR 🔴" : "NEUTRAL"), text_color=dualBullDiv ? color.green : (dualBearDiv ? color.red : color.gray), text_size=size.small)
    table.cell(mtfTable, 4, 1, isUptrend ? "BULLISH 🟢" : "BEARISH 🔴", text_color=isUptrend ? color.green : color.red, text_size=size.small)

    table.cell(mtfTable, 0, 2, "1H (Swing)", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 2, str.tostring(math.round(htf2_rsi, 1)), text_color=htf2_rsi > 50 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 2, 2, str.tostring(math.round(htf2_cci, 1)), text_color=htf2_cci > 0 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 3, 2, htf2_rsi < 35 and htf2_cci > -100 ? "BULL DIV 🟢" : (htf2_rsi > 65 and htf2_cci < 100 ? "BEAR DIV 🔴" : "NEUTRAL"), text_color=htf2_rsi < 35 ? color.green : (htf2_rsi > 65 ? color.red : color.gray), text_size=size.small)
    table.cell(mtfTable, 4, 2, htf2_close > macroEma ? "BULLISH 🟢" : "BEARISH 🔴", text_color=htf2_close > macroEma ? color.green : color.red, text_size=size.small)

    table.cell(mtfTable, 0, 3, "4H (Macro)", text_color=color.white, text_size=size.small)
    table.cell(mtfTable, 1, 3, str.tostring(math.round(htf3_rsi, 1)), text_color=htf3_rsi > 50 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 2, 3, str.tostring(math.round(htf3_cci, 1)), text_color=htf3_cci > 0 ? color.green : color.red, text_size=size.small)
    table.cell(mtfTable, 3, 3, htf3_rsi < 35 and htf3_cci > -100 ? "MACRO BULL 🏛️🟢" : (htf3_rsi > 65 and htf3_cci < 100 ? "MACRO BEAR 🏛️🔴" : "NEUTRAL"), text_color=htf3_rsi < 35 ? color.green : (htf3_rsi > 65 ? color.red : color.gray), text_size=size.small)
    table.cell(mtfTable, 4, 3, htf3_close > macroEma ? "BULLISH 🟢" : "BEARISH 🔴", text_color=htf3_close > macroEma ? color.green : color.red, text_size=size.small)
