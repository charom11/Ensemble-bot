//@version=5
indicator("Institutional Order Flow & Footprint Delta Absorption", overlay=true)

// ==============================================================================
// 1. INPUTS & CONFIGURATION
// ==============================================================================
absorption_threshold = input.float(1.8, "Absorption Volume Multiplier", minval=1.1, maxval=5.0, step=0.1)
vol_period           = input.int(20, "Average Volume Period", minval=5)
show_poc             = input.bool(true, "Show Volume Profile POC Line")
show_cvd_table       = input.bool(true, "Display Order Flow Dashboard")

// ==============================================================================
// 2. AGGRESSIVE DELTA & CUMULATIVE VOLUME DELTA (CVD) ESTIMATION
// ==============================================================================
// Estimate aggressive buy vs sell volume based on intraday bar displacement and high/low rejection
float candle_range = high - low
float upper_wick   = high - math.max(open, close)
float lower_wick   = math.min(open, close) - low
float body         = math.abs(close - open)

// Volume attribution to buyers and sellers
float buy_pct  = candle_range > 0 ? ((close - low) + lower_wick) / (2 * candle_range) : 0.5
float sell_pct = 1.0 - buy_pct

float buy_volume  = volume * buy_pct
float sell_volume = volume * sell_pct
float bar_delta   = buy_volume - sell_volume

var float cvd = 0.0
cvd := cvd + bar_delta

// ==============================================================================
// 3. INSTITUTIONAL ABSORPTION DETECTION
// ==============================================================================
float avg_vol = ta.sma(volume, vol_period)
bool high_volume_bar = volume >= (avg_vol * absorption_threshold)

// Bullish Absorption: High volume at low of bar with large lower wick (Passive buyers absorbed aggressive sellers)
bool bullish_absorption = high_volume_bar and (lower_wick >= body) and (close >= (low + candle_range * 0.35))

// Bearish Absorption: High volume at high of bar with large upper wick (Passive sellers absorbed aggressive buyers)
bool bearish_absorption = high_volume_bar and (upper_wick >= body) and (close <= (high - candle_range * 0.35))

// Delta Divergence: Price Lower Low but Delta Higher Low (or vice versa)
bool delta_bull_divergence = ta.crossunder(low, ta.lowest(low[1], 10)) and (bar_delta > ta.lowest(bar_delta[1], 10))
bool delta_bear_divergence = ta.crossover(high, ta.highest(high[1], 10)) and (bar_delta < ta.highest(bar_delta[1], 10))

// ==============================================================================
// 4. POINT OF CONTROL (POC) ESTIMATION
// ==============================================================================
// Price where most volume occurred inside the candle (approximate median weighted by body center)
float candle_poc = (open + close + high + low) / 4.0
var float rolling_poc = 0.0
rolling_poc := ta.vwma(candle_poc, 14)

plot(show_poc ? rolling_poc : na, "Order Flow POC", color=color.yellow, linewidth=2, style=plot.style_line)

// ==============================================================================
// 5. VISUAL SHAPES & SIGNALS
// ==============================================================================
// Bullish Absorption (Institutional Limit Accumulation)
plotshape(bullish_absorption, title="Bullish Absorption (Limit Buyers)", style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.normal, text="ABSORPTION\nBUY 🛡️", textcolor=color.white)

// Bearish Absorption (Institutional Limit Distribution)
plotshape(bearish_absorption, title="Bearish Absorption (Limit Sellers)", style=shape.diamond, location=location.abovebar, color=color.orange, size=size.normal, text="ABSORPTION\nSELL 🛑", textcolor=color.white)

// Delta Divergence Labels
plotshape(delta_bull_divergence, title="Bullish Delta Divergence", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(delta_bear_divergence, title="Bearish Delta Divergence", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

// Bar color by delta polarity
barcolor(bar_delta > 0 ? (bullish_absorption ? color.aqua : color.green) : (bearish_absorption ? color.orange : color.red), title="Order Flow Delta Bar Color")

// ==============================================================================
// 6. DASHBOARD TABLE
// ==============================================================================
if (show_cvd_table and barstate.islast)
    var table tb = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
    table.cell(tb, 0, 0, "Order Flow Metric", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 0, "Live Value", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    
    table.cell(tb, 0, 1, "Bar Volume Delta", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 1, (bar_delta > 0 ? "+" : "") + str.tostring(bar_delta, "#,###"), text_color=bar_delta > 0 ? color.green : color.red, text_size=size.small)
    
    table.cell(tb, 0, 2, "Cumulative Delta (CVD)", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 2, str.tostring(cvd, "#,###"), text_color=cvd > 0 ? color.green : color.red, text_size=size.small)
    
    table.cell(tb, 0, 3, "Absorption Status", text_color=color.white, text_size=size.small)
    string abs_str = bullish_absorption ? "BULLISH ABSORPTION 🛡️" : (bearish_absorption ? "BEARISH ABSORPTION 🛑" : "NONE (Active Flow)")
    color abs_col = bullish_absorption ? color.aqua : (bearish_absorption ? color.orange : color.gray)
    table.cell(tb, 1, 3, abs_str, text_color=abs_col, text_size=size.small)
    
    table.cell(tb, 0, 4, "Volume Profile POC", text_color=color.white, text_size=size.small)
    table.cell(tb, 1, 4, "$" + str.tostring(rolling_poc, "#.####"), text_color=color.yellow, text_size=size.small)
    
    table.cell(tb, 0, 5, "Order Flow Bias", text_color=color.white, text_size=size.small)
    string of_bias = bar_delta > 0 ? "AGGRESSIVE BUYING" : "AGGRESSIVE SELLING"
    table.cell(tb, 1, 5, of_bias, text_color=bar_delta > 0 ? color.green : color.red, text_size=size.small)
